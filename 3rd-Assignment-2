import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long prev2 = 0;
        long prev1 = 0;

        for (int i = 0; i < n; i++) {
            long points = sc.nextLong();
            long current = Math.max(prev1, prev2 + points);
            prev2 = prev1;
            prev1 = current;
        }

        System.out.println(prev1);
    }
}
