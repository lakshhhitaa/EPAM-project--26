import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long b = sc.nextLong();

        int[] scholarship = new int[n];

        for (int i = 0; i < n; i++) {
            scholarship[i] = sc.nextInt();
        }

        Arrays.sort(scholarship);

        long sum = 0;
        int count = 0;

        for (int amount : scholarship) {
            if (sum + amount <= b) {
                sum += amount;
                count++;
            } else {
                break;
            }
        }

        System.out.println(count);
    }
}
